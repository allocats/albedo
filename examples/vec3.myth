import "std/albedo";

[align(16)]
struct Vec3 {
    x: f32;
    y: f32;
    z: f32;
}

fn albedo::Op::Add(self: Vec3, vec: Vec3): Vec3 {
    let res: Vec3;

    res.x = self.x + vec.x;
    res.y = self.y + vec.y;
    res.z = self.z + vec.z;

    return res;
}

fn double(self: Vec3*) {
    self -> x *= 2;
    self -> y *= 2;
    self -> z *= 2;
}

fn main() {
    let a: Vec3 = Vec3 {
        .x = 0,
        .y = 1,
        .z = 2,
    };

    let b: Vec3 = Vec3 {
        .x = 0,
        .y = 1,
        .z = 2,
    };

    double(&a);

    const result: Vec3 = a + b;

    double(&result); // error! const type
}
